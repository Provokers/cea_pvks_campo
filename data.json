  "manual": [
    {
      "icone": "user",
      "titulo": "Como se apresentar",
      "texto": [
        {
          "icone": "mask",
          "t": "As entrevistadas não sabem que a pesquisa é da C&A. Assim as respostas sobre marcas e lojas ficam espontâneas."
        },
        {
          "icone": "hand",
          "t": "Apresente-se só pelo primeiro nome, como parte da equipe da pesquisa. Por exemplo: “Oi, eu sou a Gabi, estou acompanhando a conversa hoje.”"
        },
        {
          "icone": "tagoff",
          "t": "Não mencione C&A, cargo ou área. Evite crachás, sacolas, roupas ou objetos com a marca."
        },
        {
          "icone": "bubble",
          "t": "Se ela perguntar quem está por trás do estudo, diga que é uma pesquisa sobre moda e guarda-roupa e deixe a moderadora conduzir a resposta."
        }
      ]
    },
    {
      "icone": "home",
      "titulo": "Estamos entrando na casa de alguém",
      "texto": [
        {
          "icone": "people",
          "t": "Vamos visitar pessoas que vivem em contextos, realidades e condições socioeconômicas diferentes."
        },
        {
          "icone": "heart",
          "t": "É um espaço pessoal, aberto gentilmente para nós. Mantenha uma postura educada, respeitosa e livre de julgamentos sobre a casa, hábitos, objetos, opiniões ou comportamentos."
        },
        {
          "icone": "mute",
          "t": "Evite comentários, expressões ou reações que possam causar constrangimento ou fazer a entrevistada se sentir avaliada."
        }
      ]
    },
    {
      "icone": "shirt",
      "titulo": "Como me vestir",
      "texto": [
        {
          "icone": "shirt",
          "t": "Roupas básicas e confortáveis, com aparência discreta e informal: camiseta ou blusa básica, calça jeans e tênis."
        },
        {
          "icone": "sparkle",
          "t": "Evite roupas muito formais, peças ou acessórios chamativos. A visita deve ter clima próximo e natural, sem distância entre participantes e observadores."
        }
      ]
    },
    {
      "icone": "car",
      "titulo": "Locomoção e pontos de encontro",
      "texto": [
        {
          "icone": "pin",
          "t": "Chegue 10 minutos antes do horário e espere a equipe em frente à casa da entrevistada. Esse é o ponto de encontro principal."
        },
        {
          "icone": "bag",
          "t": "Depois da casa, a equipe se reencontra no shopping para a 2ª parte da visita."
        },
        {
          "icone": "car",
          "t": "Locomoção sugerida: Uber, mas não é obrigatório. Respeite o horário de encontro."
        }
      ]
    },
    {
      "icone": "question",
      "titulo": "Tenho uma pergunta. Posso fazer?",
      "texto": [
        {
          "icone": "note",
          "t": "Durante a entrevista, anote suas perguntas e impressões e deixe para conversar ao final da visita."
        },
        {
          "icone": "route",
          "t": "O ritmo da conversa é da moderadora. O roteiro segue uma ordem pensada: cada pergunta prepara a próxima até chegar às respostas que buscamos. Antecipar um assunto pode quebrar esse caminho."
        },
        {
          "icone": "whisper",
          "t": "Se surgir algo importante, fale discretamente com quem acompanha. Ela vai avaliar a melhor maneira e o melhor momento de abordar o assunto."
        }
      ]
    }
  ],
  "dos": [
    {
      "icone": "hand",
      "t": "Cumprimentar e agradecer por estar nos recebendo"
    },
    {
      "icone": "smile",
      "t": "Ser simpático e receptivo caso ela inicie uma conversa"
    },
    {
      "icone": "eye",
      "t": "Demonstrar interesse de maneira natural, sem julgamentos"
    },
    {
      "icone": "door",
      "t": "Respeitar os espaços indicados pela entrevistada e pela equipe"
    }
  ],
  "donts": [
    {
      "icone": "tagoff",
      "t": "Dizer que é da C&A ou usar algo com a marca"
    },
    {
      "icone": "route",
      "t": "Antecipar perguntas ou pular etapas do roteiro. Cada pergunta prepara a próxima, e o timing é da moderadora"
    },
    {
      "icone": "bubble",
      "t": "Completar respostas ou dar exemplos que possam influenciar o que ela dirá"
    },
    {
      "icone": "user",
      "t": "Falar sobre sua própria experiência ou opinião sobre o tema da pesquisa"
    },
    {
      "icone": "camera",
